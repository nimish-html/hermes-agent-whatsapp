# Hermes WhatsApp Agent — environment template
# Copy to .env and fill in your secrets:
#   cp .env.example .env
#
# Hermes reads project .env when HERMES_HOME is set (see .envrc).
# Config (model, provider) lives in .hermes/config.yaml.

# =============================================================================
# REQUIRED — OpenAI (LLM provider)
# =============================================================================
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: override OpenAI API base URL (default: https://api.openai.com/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Model is configured in .hermes/config.yaml (default: gpt-5.4-mini-2026-03-17).
# Change with: HERMES_HOME=$PWD/.hermes hermes config set model.default <model>

# =============================================================================
# WHATSAPP GATEWAY (Baileys — built-in Hermes bridge)
# =============================================================================
# Built-in Baileys bridge — pair with: HERMES_HOME=$PWD/.hermes hermes whatsapp
# For Kapso Cloud API instead, use the Kapso bridge block below and set false.
WHATSAPP_ENABLED=true

# Comma-separated E.164 numbers allowed to DM the bot (no + prefix)
# Example: 15551234567,919876543210
WHATSAPP_ALLOWED_USERS=

# =============================================================================
# GATEWAY (optional)
# =============================================================================
# Allow all users without an allowlist (default: false — keep false for personal use)
# GATEWAY_ALLOW_ALL_USERS=false

# =============================================================================
# VOICE / STT (optional — uses OpenAI when OPENAI_API_KEY is set)
# =============================================================================
# VOICE_TOOLS_OPENAI_KEY=   # Optional separate key for TTS/STT; falls back to OPENAI_API_KEY

# =============================================================================
# KAPSO WHATSAPP BRIDGE (integrations/kapso-hermes-bridge)
# =============================================================================
# Official WhatsApp via Kapso Cloud API — NOT Baileys. When using this path:
#   1. Set WHATSAPP_ENABLED=false (above) and enable Hermes API server vars below.
#   2. Copy integrations/kapso-hermes-bridge/.env.example → .env in that directory
#      and fill Kapso credentials (KAPSO_API_KEY, KAPSO_PHONE_NUMBER_ID,
#      KAPSO_WEBHOOK_SECRET). See integrations/kapso-hermes-bridge/README.md.
#
# Hermes gateway API server (required for the Kapso bridge):
# API_SERVER_ENABLED=true
# API_SERVER_HOST=127.0.0.1
# API_SERVER_PORT=8642
# API_SERVER_KEY=your-api-server-key
# WHATSAPP_ENABLED=false
#
# HERMES_API_KEY in the bridge .env must match API_SERVER_KEY here.

# =============================================================================
# PROJECT PATHS
# =============================================================================
# Set automatically by .envrc when using direnv; export manually otherwise:
# export HERMES_HOME="${PWD}/.hermes"
