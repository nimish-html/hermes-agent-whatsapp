# Kapso ↔ Hermes WhatsApp bridge
# Copy to .env and fill in secrets:
#   cp .env.example .env
#
# Prerequisites: Hermes gateway with API server enabled (see root .env.example
# Kapso block). Do not use Baileys WhatsApp alongside this bridge.

# =============================================================================
# KAPSO — required credentials
# =============================================================================

# HMAC secret for inbound webhook signature verification (X-Webhook-Signature).
# Set when creating the webhook (secret_key in API/CLI), or copy from the
# webhook's secret in Kapso dashboard → WhatsApp → Webhooks.
KAPSO_WEBHOOK_SECRET=your-webhook-secret-from-kapso

# Platform API key for outbound WhatsApp sends via Kapso.
# Kapso dashboard → API & webhooks → API keys → Create / copy key.
KAPSO_API_KEY=your-kapso-api-key

# WhatsApp phone number ID (Meta Cloud API id for your connected number).
# CLI: kapso whatsapp numbers list --output json  → copy the "id" field.
# Or Kapso dashboard → WhatsApp → Phone numbers.
KAPSO_PHONE_NUMBER_ID=123456789012345

# Optional override for Kapso Meta WhatsApp API base URL.
# Default: https://api.kapso.ai/meta/whatsapp/v24.0
# KAPSO_API_BASE_URL=https://api.kapso.ai/meta/whatsapp/v24.0

# =============================================================================
# HERMES API — bridge talks to Hermes gateway API server
# =============================================================================
# HERMES_API_KEY must match API_SERVER_KEY in Hermes ~/.hermes/.env (or root .env).

HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=your-api-server-key
# Optional model override for /api/sessions/{id}/chat
# HERMES_MODEL=hermes-agent

# =============================================================================
# BRIDGE HTTP server
# =============================================================================
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8787
LOG_LEVEL=INFO

# =============================================================================
# Idempotency (dedupe X-Idempotency-Key from Kapso webhooks)
# =============================================================================
IDEMPOTENCY_BACKEND=sqlite
IDEMPOTENCY_DB_PATH=./data/idempotency.db
IDEMPOTENCY_TTL_HOURS=168

# Fly.io / production: Redis dedup across instances (optional)
# IDEMPOTENCY_BACKEND=redis
# REDIS_URL=redis://default:password@fly-kapso-bridge-redis.upstash.io:6379
